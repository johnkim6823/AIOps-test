# Phase 3 환경변수. 실제 값은 ./.env 에 복사 후 채우고 git 에는 절대 커밋하지 말 것.
# (.gitignore 에 .env 등록되어 있음)

# ============================================================
# n8n 보안
# ============================================================
# 워크플로우 credential 암호화 키. 32자 이상 권장. 한 번 설정 후 변경하면 기존
# credential 모두 복호화 불가가 되므로 주의.
N8N_ENCRYPTION_KEY=please-change-me-32-chars-or-more-aiops-lab-2026

# n8n UI 가 외부에서 접근될 base URL. ngrok 으로 노출할 경우 ngrok URL 사용.
# Slack interactivity 콜백을 받으려면 반드시 https URL 이어야 함.
WEBHOOK_URL=http://localhost:5678/

# ============================================================
# LLM
# ============================================================
# CPU 환경(VirtualBox)에서는 qwen2.5:3b 또는 phi3:mini 권장 (응답 10~20초)
# GPU 호스트 + 패스스루 시 qwen2.5:7b 가능
OLLAMA_MODEL=qwen2.5:3b

# ============================================================
# Slack — aiops-lab/docs/slack-setup.md 참고하여 발급
# ============================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#alerts
SLACK_SIGNING_SECRET=

# ============================================================
# RL 추론 엔드포인트 — 기본은 04a 휴리스틱 스텁 컨테이너
# Phase 4b 의 학습된 SAC 체크포인트로 전환할 때:
#   1) ../04-rl/serve.py 를 별도 띄우기 (예: 호스트 8001 포트)
#   2) RL_DECIDE_URL=http://host.docker.internal:8001/decide
# ============================================================
RL_DECIDE_URL=http://rl-stub:8000/decide

# ============================================================
# 기타
# ============================================================
TIMEZONE=Asia/Seoul
