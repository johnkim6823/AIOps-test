# Centralized lab configuration. 모든 Phase 의 스크립트가 이 파일을 source 하여
# cluster name / namespace / image tag / chart version 등 단일 진실 원천으로 사용.
#
# 운영자가 변경 빈도 높은 항목을 한 곳에 모아둔다. Slack 시크릿 / K8S_TOKEN 같은
# 민감값은 03-workflow/.env 에 별도 저장 (gitignore).

# ---- Cluster ----
LAB_CLUSTER_NAME="aiops-lab"
LAB_KIND_VERSION="v1.30.0"

# ---- Namespaces ----
LAB_NS_VICTIM="prod"
LAB_NS_MONITORING="monitoring"
LAB_NS_LOGGING="logging"
LAB_NS_SYSTEM="kube-system"

# ---- Helm chart versions ----
LAB_CHART_KUBE_PROM="62.6.0"
LAB_CHART_LOKI_STACK="2.10.2"
LAB_CHART_INGRESS_NGINX_REF="controller-v1.11.2"

# ---- Container images ----
LAB_IMG_N8N="n8nio/n8n:1.61.0"
LAB_IMG_REDIS="redis:7-alpine"
LAB_IMG_QDRANT="qdrant/qdrant:v1.10.1"
LAB_IMG_OLLAMA="ollama/ollama:0.3.10"
LAB_IMG_VICTIM_TAG="payment-api:demo"

# ---- Default Ollama model (CPU 환경) ----
LAB_OLLAMA_MODEL="qwen2.5:3b"

# ---- Helm release names ----
LAB_RELEASE_PROM="prom-stack"
LAB_RELEASE_LOKI="loki"

# 모든 export — child shell 에서도 사용 가능
export LAB_CLUSTER_NAME LAB_KIND_VERSION
export LAB_NS_VICTIM LAB_NS_MONITORING LAB_NS_LOGGING LAB_NS_SYSTEM
export LAB_CHART_KUBE_PROM LAB_CHART_LOKI_STACK LAB_CHART_INGRESS_NGINX_REF
export LAB_IMG_N8N LAB_IMG_REDIS LAB_IMG_QDRANT LAB_IMG_OLLAMA LAB_IMG_VICTIM_TAG
export LAB_OLLAMA_MODEL
export LAB_RELEASE_PROM LAB_RELEASE_LOKI
